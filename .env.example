# ===================================
# Flight Price Comparison — Configuration
# ===================================
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to version control. On a server: chmod 600 .env

# --- Platform logins (required) ---

# ShareTrip (sharetrip.net)
SHARETRIP_EMAIL=your_email@example.com
SHARETRIP_PASSWORD=your_password

# GoZayaan (gozayaan.com)
GOZAYAAN_EMAIL=your_email@example.com
GOZAYAAN_PASSWORD=your_password

# Shohoz needs no credentials — its search API is public and requires no login.


# --- Server (optional) ---

# Port the dashboard listens on.
PORT=3000

# How many searches may run at once. Each one drives two headless Chromium
# instances, so unbounded concurrency saturates the CPU rather than going
# faster. Searches beyond this queue instead of competing. Use 1 on a small
# (2 vCPU) server.
MAX_CONCURRENT_COMPARISONS=2


# --- Daily snapshot email (optional, scripts/daily-snapshot.js) ---
# Gmail requires an APP PASSWORD, not your account password: enable 2-Step
# Verification, then create one at myaccount.google.com/apppasswords.
# Leave these blank to skip emailing — the snapshot still writes
# results/comparison_list_<search date>.csv either way.
SMTP_USER=you@gmail.com
SMTP_APP_PASSWORD=xxxxxxxxxxxxxxxx
SMTP_TO=you@gmail.com

# --- Excel output (optional, scripts/daily-snapshot.js) ---
# Workbook the daily run appends a dated sheet to, laid out like the date tabs in the main
# "Air Price Analysis.xlsx". Point this at a OneDrive/SharePoint-synced folder and the file
# syncs up automatically. Leave blank to skip the Excel write; the CSV is written regardless.
# Never point this at the main analysis workbook — exceljs rewrites the whole file and would
# destroy its pivot tables and drawings.
SNAPSHOT_XLSX=C:\Users\you\OneDrive - Shohoz\marketing - Growth-2024\Air Price Daily Snapshot.xlsx
