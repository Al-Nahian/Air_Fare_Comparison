# ===================================
# Flight Price Comparison — Credentials
# ===================================
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to version control.

# ShareTrip (sharetrip.net)
SHARETRIP_EMAIL=your_email@example.com
SHARETRIP_PHONE=01XXXXXXXXX
SHARETRIP_PASSWORD=your_password

# GoZayaan (gozayaan.com)
GOZAYAAN_EMAIL=your_email@example.com
GOZAYAAN_PASSWORD=your_password

# Shohoz (shohoz.com)
SHOHOZ_PHONE=01XXXXXXXXX
SHOHOZ_PASSWORD=your_password

# Server
PORT=3000

# --- Daily snapshot email (scripts/daily-snapshot.js) ---
# Gmail requires an APP PASSWORD, not your account password: enable 2-Step Verification, then
# create one at myaccount.google.com/apppasswords. Leave these blank to skip emailing entirely —
# the snapshot still writes results/price-history.csv either way.
SMTP_USER=you@gmail.com
SMTP_APP_PASSWORD=xxxxxxxxxxxxxxxx
SMTP_TO=you@gmail.com
